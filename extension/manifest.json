{
  "manifest_version": 3,
  "name": "Endo's Unified Downloader",
  "short_name": "Endo DL",
  "version": "1.5.0",
  "description": "Finds videos and HLS (m3u8) streams on any page and sends them to Endo's Unified Downloader; records blob/MSE video the downloader cannot fetch.",
  "minimum_chrome_version": "121",
  "permissions": ["webRequest", "storage", "scripting", "contextMenus", "cookies"],
  "host_permissions": ["<all_urls>"],
  "background": {
    "service_worker": "background.js",
    "scripts": ["background.js"],
    "type": "module"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "endo-downloader@local",
      "strict_min_version": "128.0"
    }
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Endo's Unified Downloader",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "exclude_matches": ["https://*.doubleclick.net/*", "https://www.google.com/recaptcha/*"],
      "js": ["content/hook.js"],
      "run_at": "document_start",
      "all_frames": true,
      "match_about_blank": true,
      "world": "MAIN"
    },
    {
      "matches": ["<all_urls>"],
      "exclude_matches": ["https://*.doubleclick.net/*", "https://www.google.com/recaptcha/*"],
      "js": ["content/bridge.js"],
      "run_at": "document_start",
      "all_frames": true,
      "match_about_blank": true,
      "world": "ISOLATED"
    },
    {
      "matches": ["https://www.youtube.com/*", "https://m.youtube.com/*"],
      "js": ["content/youtube.js"],
      "run_at": "document_idle",
      "world": "ISOLATED"
    }
  ]
}
